{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "certificate": {
    "store": "mozilla"
  },
  "dns": {
    "servers": [
      {
        "detour": "default",
        "server": "49.12.223.2",
        "tag": "remote",
        "type": "tcp"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "xd",
      "external_ui_download_detour": "direct",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/archive/gh-pages.zip"
    }
  },
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 7890,
      "set_system_proxy": true,
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "auto",
        "manual",
        "direct"
      ],
      "tag": "default",
      "type": "selector"
    },
    {
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "auto",
      "type": "urltest",
      "url": "https://www.youtube.com/generate_204"
    },
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "manual",
      "type": "selector"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "server": "127.0.0.1",
      "server_port": 1819,
      "tag": "💙 Telegram: @BreakRealFree",
      "type": "socks"
    },
    {
      "server": "127.0.0.1",
      "server_port": 9050,
      "tag": "tor",
      "type": "socks"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "rule_set": [
      {
        "download_detour": "direct",
        "tag": "geoip-ir",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geoip-ir.srs"
      },
      {
        "download_detour": "direct",
        "tag": "geosite-ir",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geosite-ir.srs"
      },
      {
        "download_detour": "direct",
        "tag": "geosite-private",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geosite-private.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "outbound": "direct",
        "process_name": [
          "aether",
          "aether.exe",
          "geoclue",
          "geoclue.exe",
          "lyrebird",
          "lyrebird.exe",
          "tor",
          "tor.exe"
        ]
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "protocol": [
          "bittorrent",
          "ntp"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geoip-ir",
          "geosite-ir",
          "geosite-private"
        ]
      }
    ]
  }
}
