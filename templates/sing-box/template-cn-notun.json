{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "certificate": {
    "store": "mozilla"
  },
  "dns": {
    "cache_capacity": 8192,
    "optimistic": true,
    "rules": [
      {
        "rule_set": "geosite-private",
        "server": "local"
      }
    ],
    "servers": [
      {
        "detour": "default",
        "server": "94.140.14.14",
        "tag": "remote",
        "type": "https"
      },
      {
        "tag": "local",
        "type": "local"
      }
    ],
    "strategy": "ipv4_only"
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_dns": true
    }
  },
  "http_clients": [
    {
      "tag": "default"
    }
  ],
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 7890,
      "set_system_proxy": true,
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "ntp": {
    "enabled": true,
    "server": "time.windows.com",
    "server_port": 123
  },
  "outbounds": [
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "auto",
        "manual",
        "direct"
      ],
      "tag": "default",
      "type": "selector"
    },
    {
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "auto",
      "type": "urltest",
      "url": "https://www.youtube.com/generate_204"
    },
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "manual",
      "type": "selector"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "server": "127.0.0.1",
      "server_port": 1819,
      "tag": "💙 Telegram: @BreakRealFree",
      "type": "socks"
    },
    {
      "server": "127.0.0.1",
      "server_port": 9050,
      "tag": "tor",
      "type": "socks"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geoip-cn.srs"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-cn.srs"
      },
      {
        "tag": "geosite-private",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-private.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "process_name": [
          "aether",
          "aether.exe",
          "geoclue",
          "geoclue.exe",
          "lyrebird",
          "lyrebird.exe",
          "tor",
          "tor.exe"
        ]
      },
      {
        "outbound": "direct",
        "protocol": [
          "bittorrent",
          "ntp"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geoip-cn",
          "geosite-cn",
          "geosite-private"
        ]
      }
    ]
  },
  "services": [
    {
      "dashboard": true,
      "listen_port": 9090,
      "type": "api"
    }
  ]
}
