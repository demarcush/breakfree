{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "certificate": {
    "store": "mozilla"
  },
  "dns": {
    "rules": [
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "servers": [
      {
        "detour": "default",
        "server": "1.1.1.1",
        "tag": "remote",
        "type": "https"
      },
      {
        "tag": "local",
        "type": "local"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "fakeip",
        "type": "fakeip"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    }
  },
  "http_clients": [
    {
      "tag": "default"
    }
  ],
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "exclude_package": [
        "com.android.captiveportallogin",
        "org.bepass.oblivion",
        "org.proninyaroslav.libretorrent",
        "org.torproject.android",
        "org.torproject.torbrowser"
      ],
      "stack": "gvisor",
      "strict_route": true,
      "type": "tun"
    },
    {
      "listen": "::",
      "listen_port": 7890,
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "outbounds": [
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "auto",
        "manual",
        "direct"
      ],
      "tag": "default",
      "type": "selector"
    },
    {
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "auto",
      "type": "urltest",
      "url": "https://www.youtube.com/generate_204"
    },
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "manual",
      "type": "selector"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "server": "127.0.0.1",
      "server_port": 1819,
      "tag": "💙 Telegram: @BreakRealFree",
      "type": "socks"
    },
    {
      "server": "127.0.0.1",
      "server_port": 9050,
      "tag": "tor",
      "type": "socks"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "rule_set": [
      {
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-category-ads-all.srs"
      },
      {
        "tag": "geosite-category-consent-management",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-category-consent-management.srs"
      },
      {
        "tag": "geosite-cryptominers",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-cryptominers.srs"
      },
      {
        "tag": "geosite-malware",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-malware.srs"
      },
      {
        "tag": "geosite-phishing",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-phishing.srs"
      },
      {
        "tag": "geosite-nsfw",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-nsfw.srs"
      },
      {
        "tag": "geoip-malware",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geoip-malware.srs"
      },
      {
        "tag": "geoip-phishing",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geoip-phishing.srs"
      },
      {
        "tag": "geosite-connectivity-check",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-connectivity-check.srs"
      },
      {
        "tag": "geosite-private",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-private.srs"
      },
      {
        "tag": "geosite-ir",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geosite-ir.srs"
      },
      {
        "tag": "geoip-ir",
        "type": "remote",
        "url": "https://cdn.jsdelivr.net/gh/Chocolate4U/Iran-sing-box-rules@refs/heads/rule-set/geoip-ir.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "process_name": [
          "aether",
          "aether.exe",
          "geoclue",
          "geoclue.exe",
          "lyrebird",
          "lyrebird.exe",
          "tor",
          "tor.exe"
        ]
      },
      {
        "outbound": "direct",
        "protocol": [
          "bittorrent",
          "ntp"
        ]
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all",
          "geosite-category-consent-management",
          "geosite-cryptominers",
          "geosite-malware",
          "geosite-phishing",
          "geoip-malware",
          "geoip-phishing"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geosite-connectivity-check",
          "geosite-private",
          "geosite-ir",
          "geoip-ir"
        ]
      }
    ]
  },
  "services": [
    {
      "dashboard": true,
      "listen_port": 9090,
      "type": "api"
    }
  ]
}
