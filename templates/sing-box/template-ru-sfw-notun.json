{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "certificate": {
    "store": "mozilla"
  },
  "dns": {
    "independent_cache": true,
    "rules": [
      {
        "query_type": [
          "A",
          "AAAA"
        ],
        "server": "fakeip"
      }
    ],
    "servers": [
      {
        "detour": "default",
        "server": "1.1.1.2",
        "tag": "remote",
        "type": "https"
      },
      {
        "tag": "local",
        "type": "local"
      },
      {
        "inet4_range": "198.18.0.0/15",
        "inet6_range": "fc00::/18",
        "tag": "fakeip",
        "type": "fakeip"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "xd",
      "external_ui_download_detour": "direct",
      "external_ui_download_url": "https://github.com/MetaCubeX/metacubexd/archive/gh-pages.zip"
    }
  },
  "inbounds": [
    {
      "listen": "::",
      "listen_port": 7890,
      "set_system_proxy": true,
      "type": "mixed"
    }
  ],
  "log": {
    "level": "warn"
  },
  "ntp": {
    "enabled": true,
    "server": "time.windows.com",
    "server_port": 123
  },
  "outbounds": [
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "auto",
        "manual",
        "direct"
      ],
      "tag": "default",
      "type": "selector"
    },
    {
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "auto",
      "type": "urltest",
      "url": "https://www.youtube.com/generate_204"
    },
    {
      "interrupt_exist_connections": true,
      "outbounds": [
        "💙 Telegram: @BreakRealFree",
        "tor"
      ],
      "tag": "manual",
      "type": "selector"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "server": "127.0.0.1",
      "server_port": 1819,
      "tag": "💙 Telegram: @BreakRealFree",
      "type": "socks"
    },
    {
      "server": "127.0.0.1",
      "server_port": 9050,
      "tag": "tor",
      "type": "socks"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "rule_set": [
      {
        "download_detour": "direct",
        "tag": "geosite-category-ads-all",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geosite-category-ads-all.srs"
      },
      {
        "download_detour": "direct",
        "tag": "geosite-nsfw",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geosite-nsfw.srs"
      },
      {
        "download_detour": "direct",
        "tag": "geoip-ru",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geoip-ru.srs"
      },
      {
        "download_detour": "direct",
        "tag": "geosite-category-ru",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geosite-category-ru.srs"
      },
      {
        "download_detour": "direct",
        "tag": "geosite-private",
        "type": "remote",
        "url": "https://raw.githubusercontent.com/Chocolate4U/Iran-sing-box-rules/refs/heads/rule-set/geosite-private.srs"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "process_name": [
          "aether",
          "aether.exe",
          "geoclue",
          "geoclue.exe",
          "lyrebird",
          "lyrebird.exe",
          "tor",
          "tor.exe"
        ]
      },
      {
        "outbound": "direct",
        "protocol": [
          "bittorrent",
          "ntp"
        ]
      },
      {
        "action": "reject",
        "rule_set": [
          "geosite-category-ads-all",
          "geosite-nsfw"
        ]
      },
      {
        "outbound": "direct",
        "rule_set": [
          "geoip-ru",
          "geosite-category-ru",
          "geosite-private"
        ]
      }
    ]
  }
}
